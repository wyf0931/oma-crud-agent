# ============================================
# OpenAI-compatible LLM Configuration
# ============================================

# API key
OPENAI_API_KEY=your-api-key-here

# Base URL; change this for another OpenAI-compatible provider
OPENAI_BASE_URL=https://api.openai.com/v1

# Model
OPENAI_MODEL=gpt-4o-mini

# Optional structured JSON output for agent calls
# Leave empty if the configured provider does not support response_format.
OPENAI_RESPONSE_FORMAT=json_object

# ============================================
# Application Configuration
# ============================================

# Unified local data root. Defaults to ./data when omitted.
# DATA_DIR=./data

# Server
HOST=127.0.0.1
PORT=8020

# Debug mode
DEBUG=false
